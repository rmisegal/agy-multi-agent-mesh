# agymesh needs no secrets. These optional variables override config/setup.json.
# Copy to .env (git-ignored) or set them in your shell.

# Folder that holds setup.json and rate_limits.json
AGYMESH_CONFIG_DIR=./config
# Team definition (agents, folders, roles, task templates)
AGYMESH_TEAM=./examples/creative-trio/team.json
# Hub address (keep it on localhost)
AGYMESH_HOST=127.0.0.1
AGYMESH_PORT=9877
